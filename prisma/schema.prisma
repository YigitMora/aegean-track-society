generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  COMPLETED
  CANCELLED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum RegistrationStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REJECTED
}

enum RegistrationSource {
  PUBLIC_ANONYMOUS
  MEMBER_ACCOUNT
  ADMIN_CREATED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  REVIEW
}

enum MyTrackPaymentPreference {
  BANK_TRANSFER
  CARD_AT_TRACK
}

enum PaymentProvider {
  IYZICO
  MANUAL
  BANK_TRANSFER
}

enum ProviderPaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REVIEW
  CANCELLED
  REFUNDED
}

enum AdminRole {
  OWNER
  STAFF
  CHECKIN
}

enum CheckInStatus {
  ELIGIBLE
  CHECKED_IN
  BLOCKED
  VOID
}

enum EmailType {
  CONFIRMATION
  PAYMENT_FAILED
  ADMIN_NOTICE
  REGISTRATION_RECEIVED
  ADMIN_NEW_REGISTRATION
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum MemberRole {
  MEMBER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum AccountDeletionStage {
  VERIFICATION_PENDING
  VERIFIED
  STORAGE_PENDING
  DATABASE_PENDING
  AUTH_PENDING
  AUTH_DELETE_RETRY
  COMPLETED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum AccountDeletionOutboxStatus {
  PENDING
  RETRYABLE
  SENT
  FAILED_FINAL
}

enum ModificationCategory {
  ENGINE
  ECU
  COOLING
  INTAKE_EXHAUST
  SUSPENSION
  BRAKES
  TYRES
  WHEELS
  DRIVETRAIN
  AERO
  SAFETY
  OTHER
}

enum ModificationRuleType {
  CONFLICTS_WITH
  REQUIRES
}

enum ModificationUsageClass {
  STREET
  FAST_ROAD
  STREET_TRACK
  TRACK
  ENDURANCE
  SPRINT
  RACE
}

enum BigBrakeKitAxle {
  FRONT
  REAR
  BOTH
}

enum RotorConstruction {
  ONE_PIECE
  TWO_PIECE_FLOATING
}

enum CaliperType {
  FIXED
  FLOATING
}

enum TyreClass {
  TOURING
  UHP_ROAD
  MAX_PERFORMANCE_ROAD
  EXTREME_PERFORMANCE
  TRACKDAY
  SEMI_SLICK
  SLICK
  WET_RACING
}

enum WheelConstruction {
  CAST
  FLOW_FORMED
  FORGED
  MULTI_PIECE
}

enum VehiclePowertrain {
  ICE
  HYBRID
  ELECTRIC
}

enum VehicleDrivetrain {
  FWD
  RWD
  AWD
}

enum VehicleRatingStatus {
  CALIBRATED
  PROVISIONAL
  UNAVAILABLE
}

enum VehicleCatalogMatchRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum EngineInductionType {
  NATURALLY_ASPIRATED
  TURBOCHARGED
  SUPERCHARGED
  TWIN_TURBO
}

enum EngineFuelType {
  PETROL
  DIESEL
  FLEX_FUEL
  HYBRID_PETROL
  HYBRID_DIESEL
}

enum TuningPackageType {
  ECU_FLASH
  PIGGYBACK
  ECU_TCU_BUNDLE
  TCU_SOFTWARE
  FLEX_FUEL_CALIBRATION
  HARDWARE_SOFTWARE_PACKAGE
}

enum PowerMeasurementBasis {
  CRANK
  WHEEL
  UNSPECIFIED
}

enum CalibrationConfidence {
  HIGH
  MEDIUM
  LOW
}

model Event {
  id                      String         @id @default(cuid())
  code                    String         @unique
  slug                    String         @unique
  name                    String
  venue                   String
  startsAt                DateTime
  endsAt                  DateTime
  timezone                String         @default("Europe/Istanbul")
  status                  EventStatus    @default(DRAFT)
  participantSequenceNext Int            @default(1)
  days                    EventDay[]
  packages                EventPackage[]
  registrations           Registration[]
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([status])
}

model EventDay {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date      DateTime          @db.Date
  label     String
  packages  EventPackageDay[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([eventId, date])
  @@index([date])
}

model EventPackage {
  id            String            @id @default(cuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String
  name          String
  price         Decimal           @db.Decimal(10, 2)
  currency      String            @default("TRY")
  capacity      Int
  active        Boolean           @default(true)
  days          EventPackageDay[]
  registrations Registration[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([eventId, code])
  @@index([active])
}

model EventPackageDay {
  id         String       @id @default(cuid())
  packageId  String
  package    EventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  eventDayId String
  eventDay   EventDay     @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([packageId, eventDayId])
}

model Registration {
  id                        String             @id @default(cuid())
  participantCode           String?            @unique
  eventId                   String
  event                     Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  packageId                 String
  package                   EventPackage       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  userId                    String?            @db.Uuid
  user                      User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicleId                 String?
  vehicle                   Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  registrationSource        RegistrationSource @default(PUBLIC_ANONYMOUS)
  fullName                  String
  phone                     String
  email                     String
  carBrandModel             String
  plateNumber               String
  experienceLevel           ExperienceLevel
  emergencyContactName      String
  emergencyContactPhone     String
  kvkkAcceptedAt            DateTime
  liabilityWaiverAcceptedAt DateTime
  marketingConsentAt        DateTime?
  consentIpAddress          String?            @db.VarChar(45)
  adminNotes                String?            @db.Text
  adminNoteEntries          AdminNote[]
  status                    RegistrationStatus @default(DRAFT)
  paymentStatus             PaymentStatus      @default(UNPAID)
  mytrackPaymentPreference  MyTrackPaymentPreference?
  qrTokenHash               String?            @unique
  qrIssuedAt                DateTime?
  deletedAt                 DateTime?
  deletedByAdminId          String?
  deletedByAdmin            AdminUser?         @relation("RegistrationDeletedBy", fields: [deletedByAdminId], references: [id], onDelete: SetNull)
  deleteReason              String?            @db.Text
  payments                  Payment[]
  checkIns                  CheckIn[]
  auditLogs                 AuditLog[]
  emails                    EmailLog[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([eventId, status])
  @@index([paymentStatus])
  @@index([mytrackPaymentPreference])
  @@index([packageId])
  @@index([email])
  @@index([phone])
  @@index([plateNumber])
  @@index([deletedAt])
  @@index([userId, deletedAt])
  @@index([vehicleId])
  @@index([eventId, userId, deletedAt])
  @@index([status, deletedAt])
  @@index([deletedByAdminId])
}

model Payment {
  id                    String                @id @default(cuid())
  registrationId        String
  registration          Registration          @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  provider              PaymentProvider       @default(IYZICO)
  conversationId        String                @unique
  iyzicoToken           String?               @unique
  iyzicoPaymentId       String?
  amount                Decimal               @db.Decimal(10, 2)
  currency              String                @default("TRY")
  status                ProviderPaymentStatus @default(INITIATED)
  rawInitializeResponse Json?
  rawCallbackResponse   Json?
  rawWebhookPayload     Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([registrationId])
  @@index([status])
  @@index([iyzicoPaymentId])
}

model AdminUser {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  role                 AdminRole      @default(STAFF)
  checkIns             CheckIn[]
  auditLogs            AuditLog[]
  adminNotes           AdminNote[]
  resolvedCatalogMatchRequests VehicleCatalogMatchRequest[] @relation("CatalogMatchRequestResolver")
  deletedRegistrations Registration[] @relation("RegistrationDeletedBy")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model AdminNote {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  adminUserId    String?
  adminUser      AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  authorLabel    String
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([registrationId, createdAt])
  @@index([adminUserId])
}

model CheckIn {
  id                    String        @id @default(cuid())
  registrationId        String
  registration          Registration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  eventDate             DateTime      @db.Date
  checkedInAt           DateTime?
  checkedInByAdminId    String?
  checkedInByAdmin      AdminUser?    @relation(fields: [checkedInByAdminId], references: [id], onDelete: SetNull)
  status                CheckInStatus @default(ELIGIBLE)
  duplicateAttemptCount Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([registrationId, eventDate])
  @@index([eventDate, status])
  @@index([checkedInByAdminId])
}

model AuditLog {
  id             String        @id @default(cuid())
  adminUserId    String?
  adminUser      AdminUser?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  action         String
  before         Json?
  after          Json?
  reason         String?       @db.Text
  ipAddress      String?       @db.VarChar(45)
  createdAt      DateTime      @default(now())

  @@index([adminUserId])
  @@index([registrationId])
  @@index([action])
}

model EmailLog {
  id                String       @id @default(cuid())
  registrationId    String
  registration      Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  type              EmailType
  status            EmailStatus  @default(PENDING)
  providerMessageId String?
  createdAt         DateTime     @default(now())

  @@index([registrationId])
  @@index([type, status])
}

model User {
  id                              String         @id @db.Uuid
  email                           String         @unique
  role                            MemberRole     @default(MEMBER)
  status                          MemberStatus   @default(ACTIVE)
  memberKvkkAcceptedAt            DateTime?
  memberTermsAcceptedAt           DateTime?
  memberMarketingConsentAt        DateTime?
  memberMarketingConsentRevokedAt DateTime?
  memberConsentIpAddress          String?        @db.VarChar(45)
  profile                         MemberProfile?
  vehicles                        Vehicle[]
  vehicleCatalogMatchRequests     VehicleCatalogMatchRequest[]
  registrations                   Registration[]
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  deletedAt                       DateTime?

  @@index([status])
}

model AccountDeletionRequest {
  id                   String               @id @default(cuid())
  authUserIdHash       String               @unique
  stage                AccountDeletionStage @default(VERIFICATION_PENDING)
  verificationHash     String?
  verificationExpiresAt DateTime?
  verificationAttempts Int                  @default(0)
  resendCount          Int                  @default(0)
  lastSentAt           DateTime?
  idempotencyKeyHash   String?              @unique
  operationReceiptHash String?              @unique
  encryptedAuthUserId  String?
  encryptedEmail       String?
  executionLeaseId     String?
  executionLeaseExpiresAt DateTime?
  operationVersion     Int                  @default(0)
  nextAttemptAt        DateTime?
  purgeAfter           DateTime?
  legalHold            Boolean              @default(false)
  legalHoldReason      String?              @db.Text
  legalHoldUntil       DateTime?
  safeErrorCode        String?
  storageCompletedAt   DateTime?
  databaseCompletedAt  DateTime?
  authCompletedAt      DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  emailOutbox          AccountDeletionEmailOutbox[]

  @@index([stage])
  @@index([verificationExpiresAt])
  @@index([completedAt])
  @@index([stage, nextAttemptAt])
  @@index([executionLeaseExpiresAt])
}

model AccountDeletionEmailOutbox {
  id                       String                       @id @default(cuid())
  accountDeletionRequestId String
  request                  AccountDeletionRequest       @relation(fields: [accountDeletionRequestId], references: [id], onDelete: Cascade)
  status                   AccountDeletionOutboxStatus  @default(PENDING)
  recipientCiphertext      String?
  executionLeaseId         String?
  executionLeaseExpiresAt  DateTime?
  attemptCount             Int                          @default(0)
  lastAttemptAt            DateTime?
  sentAt                   DateTime?
  safeErrorCode            String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@unique([accountDeletionRequestId])
  @@index([status, executionLeaseExpiresAt])
}

model Vehicle {
  id                  String                @id @default(cuid())
  userId              String                @db.Uuid
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicleDefinitionId String?
  vehicleDefinition   VehicleDefinition?    @relation(fields: [vehicleDefinitionId], references: [id], onDelete: SetNull)
  brand               String
  model               String
  year                Int?
  plateNumber         String
  color               String?
  isPrimary           Boolean               @default(false)
  imagePath           String?
  deletedAt           DateTime?
  registrations       Registration[]
  modifications       VehicleModification[]
  catalogMatchRequests VehicleCatalogMatchRequest[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId, deletedAt])
  @@index([userId, isPrimary, deletedAt])
  @@index([vehicleDefinitionId])
  @@index([plateNumber])
}

model VehicleCatalogMatchRequest {
  id                        String                           @id @default(cuid())
  userId                    String                           @db.Uuid
  user                      User                             @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicleId                 String?
  vehicle                   Vehicle?                         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status                    VehicleCatalogMatchRequestStatus @default(PENDING)
  memberNote                String?                          @db.Text
  adminNote                 String?                          @db.Text
  resolvedByAdminUserId     String?
  resolvedByAdminUser       AdminUser?                       @relation("CatalogMatchRequestResolver", fields: [resolvedByAdminUserId], references: [id], onDelete: SetNull)
  resolvedAt                DateTime?
  memberNotifiedAt          DateTime?
  adminNotificationEmailSentAt DateTime?
  adminNotificationEmailFailedAt DateTime?
  memberNotificationEmailSentAt DateTime?
  memberNotificationEmailFailedAt DateTime?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([resolvedByAdminUserId])
}

model VehicleDefinition {
  id                   String                      @id @default(cuid())
  code                 String                      @unique
  brand                String
  model                String
  generation           String?
  chassisCode          String?
  variant              String?
  yearFrom             Int?
  yearTo               Int?
  powertrain           VehiclePowertrain
  drivetrain           VehicleDrivetrain
  platformFamilyId     String?
  platformFamily       VehiclePlatformFamily?      @relation(fields: [platformFamilyId], references: [id], onDelete: SetNull)
  engineFamilyId       String?
  engineFamily         VehicleEngineFamily?        @relation(fields: [engineFamilyId], references: [id], onDelete: SetNull)
  powerRating          Int
  handlingRating       Int
  brakingRating        Int
  reliabilityRating    Int
  thermalRating        Int
  trackReadinessRating Int
  weightPenalty        Int                         @default(0)
  ratingStatus         VehicleRatingStatus         @default(PROVISIONAL)
  active               Boolean                     @default(true)
  sortOrder            Int                         @default(0)
  vehicles             Vehicle[]
  modificationImpacts  VehicleModificationImpact[]
  compatibilities      ModificationCompatibility[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([brand, model, active])
  @@index([generation, variant, active])
  @@index([platformFamilyId, active])
  @@index([engineFamilyId, active])
}

model VehiclePlatformFamily {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  brand              String
  name               String
  generation         String?
  active             Boolean                     @default(true)
  vehicleDefinitions VehicleDefinition[]
  compatibilities    ModificationCompatibility[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([brand, active])
}

model VehicleEngineFamily {
  id                 String                      @id @default(cuid())
  code               String                      @unique
  manufacturer       String
  name               String
  displacementCc     Int?
  cylinderCount      Int?
  inductionType      EngineInductionType?
  fuelType           EngineFuelType?
  active             Boolean                     @default(true)
  vehicleDefinitions VehicleDefinition[]
  compatibilities    ModificationCompatibility[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([manufacturer, active])
}

model ModificationDefinition {
  id                         String                             @id @default(cuid())
  code                       String                             @unique
  category                   ModificationCategory
  brand                      String?
  name                       String
  variant                    String?
  componentTypeCode          String?
  usageClass                 ModificationUsageClass?
  description                String?                            @db.Text
  powerImpact                Int                                @default(0)
  handlingImpact             Int                                @default(0)
  brakingImpact              Int                                @default(0)
  reliabilityImpact          Int                                @default(0)
  trackReadinessImpact       Int                                @default(0)
  active                     Boolean                            @default(true)
  sortOrder                  Int                                @default(0)
  vehicleModifications       VehicleModification[]
  modificationImpacts        VehicleModificationImpact[]
  compatibilities            ModificationCompatibility[]
  powertrainApplicabilities  ModificationDefinitionPowertrain[]
  tuningPackageSpecification TuningPackageSpecification?
  brakePadSpecification      BrakePadSpecification?
  sportSpringSpecification   SportSpringSpecification?
  bigBrakeKitSpecification   BigBrakeKitSpecification?
  tyreSpecification          TyreSpecification?
  wheelSpecification         WheelSpecification?
  rulesAsSource              ModificationRule[]                 @relation("ModificationRuleSource")
  rulesAsTarget              ModificationRule[]                 @relation("ModificationRuleTarget")
  requirementGroups          ModificationRequirementGroup[]     @relation("ModificationRequirementSource")
  requirementOptions         ModificationRequirementOption[]    @relation("ModificationRequirementOptionDefinition")
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt

  @@index([category, active, sortOrder])
  @@index([category, componentTypeCode, active])
  @@index([brand, name])
}

model ModificationDefinitionPowertrain {
  id                       String                 @id @default(cuid())
  modificationDefinitionId String
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  powertrain               VehiclePowertrain
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@unique([modificationDefinitionId, powertrain])
  @@index([powertrain, active])
  @@index([modificationDefinitionId, active])
}

model BrakePadSpecification {
  id                       String                 @id @default(cuid())
  modificationDefinitionId String                 @unique
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  coldPerformance          Int
  hotPerformance           Int
  modulation               Int
  fadeResistance           Int
  endurance                Int
  rotorWear                Int
  streetSuitability        Int
  noiseLevel               Int
  minOperatingTempC        Int?
  maxOperatingTempC        Int?
  sourceNote               String?
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model SportSpringSpecification {
  id                         String                 @id @default(cuid())
  modificationDefinitionId   String                 @unique
  modificationDefinition     ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  approximateLoweringFrontMm Int?
  approximateLoweringRearMm  Int?
  progressiveRate            Boolean?
  roadSuitability            Int
  trackSuitability           Int
  sourceNote                 String?
  active                     Boolean                @default(true)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
}

model BigBrakeKitSpecification {
  id                       String                 @id @default(cuid())
  modificationDefinitionId String                 @unique
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  frontOrRear              BigBrakeKitAxle
  pistonCount              Int?
  rotorDiameterMm          Int?
  rotorThicknessMm         Int?
  rotorConstruction        RotorConstruction?
  caliperType              CaliperType?
  roadSuitability          Int
  trackSuitability         Int
  thermalCapacity          Int
  sourceNote               String?
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model TyreSpecification {
  id                       String                 @id @default(cuid())
  modificationDefinitionId String                 @unique
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  tyreClass                TyreClass
  dryGrip                  Int
  wetGrip                  Int
  coldPerformance          Int
  heatTolerance            Int
  trackConsistency         Int
  roadSuitability          Int
  wearLongevity            Int
  noiseComfort             Int
  roadLegal                Boolean?
  sourceNote               String?
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model WheelSpecification {
  id                       String                 @id @default(cuid())
  modificationDefinitionId String                 @unique
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  construction             WheelConstruction
  nominalDiameterInches    Int?
  nominalWidthInches       Decimal?               @db.Decimal(4, 1)
  weightKg                 Decimal?               @db.Decimal(5, 2)
  trackSuitability         Int
  roadSuitability          Int
  sourceNote               String?
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model TuningPackageSpecification {
  id                        String                 @id @default(cuid())
  modificationDefinitionId  String                 @unique
  modificationDefinition    ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  tuneType                  TuningPackageType
  measurementBasis          PowerMeasurementBasis?
  mapStageLabel             String?
  mapProgramCode            String?
  claimedPowerMinHp         Int?
  claimedPowerMaxHp         Int?
  claimedTorqueMinNm        Int?
  claimedTorqueMaxNm        Int?
  minimumFuelOctaneRon      Int?
  requiredFuelNote          String?
  hardwareRequirementNote   String?
  transmissionLimitNote     String?
  coolingRecommendationNote String?
  sourceNote                String?
  confidence                CalibrationConfidence
  active                    Boolean                @default(true)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
}

model VehicleModification {
  id                       String                 @id @default(cuid())
  vehicleId                String
  vehicle                  Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  modificationDefinitionId String
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Restrict)
  customNotes              String?                @db.Text
  installedAt              DateTime?
  deletedAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([vehicleId, deletedAt])
  @@index([modificationDefinitionId])
}

model ModificationRule {
  id                 String                 @id @default(cuid())
  sourceDefinitionId String
  sourceDefinition   ModificationDefinition @relation("ModificationRuleSource", fields: [sourceDefinitionId], references: [id], onDelete: Cascade)
  targetDefinitionId String
  targetDefinition   ModificationDefinition @relation("ModificationRuleTarget", fields: [targetDefinitionId], references: [id], onDelete: Cascade)
  ruleType           ModificationRuleType
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())

  @@unique([sourceDefinitionId, targetDefinitionId, ruleType])
  @@index([sourceDefinitionId, active])
  @@index([targetDefinitionId, active])
}

model ModificationRequirementGroup {
  id                 String                          @id @default(cuid())
  code               String                          @unique
  sourceDefinitionId String
  sourceDefinition   ModificationDefinition          @relation("ModificationRequirementSource", fields: [sourceDefinitionId], references: [id], onDelete: Cascade)
  description        String?
  active             Boolean                         @default(true)
  sortOrder          Int                             @default(0)
  options            ModificationRequirementOption[]
  createdAt          DateTime                        @default(now())

  @@index([sourceDefinitionId, active])
}

model ModificationRequirementOption {
  id                   String                       @id @default(cuid())
  requirementGroupId   String
  requirementGroup     ModificationRequirementGroup @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  requiredDefinitionId String
  requiredDefinition   ModificationDefinition       @relation("ModificationRequirementOptionDefinition", fields: [requiredDefinitionId], references: [id], onDelete: Cascade)
  createdAt            DateTime                     @default(now())

  @@unique([requirementGroupId, requiredDefinitionId])
  @@index([requiredDefinitionId])
}

model VehicleModificationImpact {
  id                       String                 @id @default(cuid())
  vehicleDefinitionId      String
  vehicleDefinition        VehicleDefinition      @relation(fields: [vehicleDefinitionId], references: [id], onDelete: Cascade)
  modificationDefinitionId String
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  powerImpact              Int                    @default(0)
  handlingImpact           Int                    @default(0)
  brakingImpact            Int                    @default(0)
  reliabilityImpact        Int                    @default(0)
  thermalImpact            Int                    @default(0)
  trackReadinessImpact     Int                    @default(0)
  confidence               CalibrationConfidence  @default(LOW)
  sourceNote               String?
  claimedPowerDeltaHp      Int?
  claimedTorqueDeltaNm     Int?
  active                   Boolean                @default(true)

  @@unique([vehicleDefinitionId, modificationDefinitionId])
  @@index([modificationDefinitionId, active])
}

model ModificationCompatibility {
  id                       String                 @id @default(cuid())
  modificationDefinitionId String
  modificationDefinition   ModificationDefinition @relation(fields: [modificationDefinitionId], references: [id], onDelete: Cascade)
  vehicleDefinitionId      String?
  vehicleDefinition        VehicleDefinition?     @relation(fields: [vehicleDefinitionId], references: [id], onDelete: Cascade)
  platformFamilyId         String?
  platformFamily           VehiclePlatformFamily? @relation(fields: [platformFamilyId], references: [id], onDelete: Cascade)
  engineFamilyId           String?
  engineFamily             VehicleEngineFamily?   @relation(fields: [engineFamilyId], references: [id], onDelete: Cascade)
  vehicleBrand             String?
  vehicleModel             String?
  yearFrom                 Int?
  yearTo                   Int?
  active                   Boolean                @default(true)

  @@unique([modificationDefinitionId, vehicleDefinitionId])
  @@unique([modificationDefinitionId, platformFamilyId])
  @@unique([modificationDefinitionId, engineFamilyId])
  @@index([modificationDefinitionId, active])
  @@index([vehicleDefinitionId, active])
  @@index([platformFamilyId, active])
  @@index([engineFamilyId, active])
  @@index([vehicleBrand, vehicleModel, active])
}

model MemberProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique @db.Uuid
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  fullName              String?
  displayName           String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  experienceLevel       ExperienceLevel?
  profileCompletedAt    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}
